{
  "version": 3,
  "permissions": [
    {
      "resource": "claims",
      "component": "expense-api",
      "description": "Expense claims and their approval",
      "actions": [
        { "handle": "read", "description": "The caller's own claims" },
        { "handle": "manage", "description": "Create, edit, withdraw or resubmit the caller's own claims" },
        { "handle": "review-team", "description": "Claims submitted by the caller's direct reports" },
        { "handle": "decide", "description": "Approve or reject a direct report's pending claim" },
        { "handle": "read-all", "description": "Every approved claim" }
      ]
    },
    {
      "resource": "exports",
      "component": "expense-api",
      "description": "Payroll exports of approved claims",
      "actions": [
        { "handle": "read", "description": "Past payroll exports" },
        { "handle": "create", "description": "Export approved claims to payroll" }
      ]
    }
  ],
  "groups": [],
  "roles": [
    {
      "name": "Employee",
      "description": "Submits and manages their own expense claims.",
      "stories": ["F1.1", "F1.2", "F1.3", "F1.4", "F1.5", "F1.6", "F1.7", "F1.8"],
      "grants": ["claims:read", "claims:manage"],
      "assignTo": ["Employees"]
    },
    {
      "name": "Manager",
      "description": "Reviews and decides their direct reports' submitted claims.",
      "stories": ["F2.1", "F2.2", "F2.3", "F2.4", "F2.5"],
      "grants": ["claims:review-team", "claims:decide"],
      "assignTo": ["Managers"]
    },
    {
      "name": "Finance",
      "description": "Exports approved claims to payroll and reviews export history.",
      "stories": ["F3.1", "F3.2"],
      "grants": ["claims:read-all", "exports:read", "exports:create"],
      "assignTo": ["Finance"]
    }
  ],
  "testUsers": [
    { "username": "test-employee", "roles": ["Employee"] },
    { "username": "test-employee-2", "roles": ["Employee"] },
    { "username": "test-manager", "roles": ["Manager"] },
    { "username": "test-manager-2", "roles": ["Manager"] },
    { "username": "test-finance", "roles": ["Finance"] }
  ]
}
